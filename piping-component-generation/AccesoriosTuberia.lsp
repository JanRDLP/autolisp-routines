(defun at:disponibles (referencia / fila resultado)
  (foreach fila (at:tabla referencia) (setq resultado (append resultado (list (car fila))))) resultado)
(defun at:datos (referencia medida) (assoc medida (at:tabla referencia)))
(defun at:tabla-bola-mm (/ resultado fila zona extension cuerpo diametro paso)
  ;; Extremos integrales dentro del largo total de la envolvente generica.
  ;; Zona NPT de referencia de la biblioteca, sin filetes ni penetracion de apriete.
  (foreach fila (at:tabla "BOLA_ROSCADA")
    (setq zona (gc:zona-niple (gc:datos-niple (car fila) 1000.0)))
    (if zona
      (progn
        (setq extension (car zona) cuerpo (- (cadr fila) (* 2.0 extension))
          diametro (cadr zona) paso (* (car fila) 25.4))
        (if (and (> cuerpo 0.0) (> diametro paso))
          (setq resultado (cons (append fila (list cuerpo extension diametro paso)) resultado))))))
  (reverse resultado))
(defun at:dn-brida (nps)
  (cadr (assoc nps '((0.5 15) (0.75 20) (1.0 25) (1.25 32) (1.5 40)
    (2.0 50) (2.5 65) (3.0 80) (3.5 90) (4.0 100) (5.0 125) (6.0 150)
    (8.0 200) (10.0 250) (12.0 300)))))
(defun at:campos-pedido (pedido / tipo referencia medida campos datos dn texto)
  (setq tipo (pd:valor pedido "pieza") referencia (pd:valor pedido "referencia") medida (pd:valor pedido "medida")
    campos (if (= tipo "PVC") (pv:campos referencia medida)
      (at:campos tipo referencia medida (pd:valor pedido "rango"))))
  (if (and (= tipo "BRIDA") (= (pd:valor pedido "unidad_brida") "DN"))
    (progn
      (setq datos (at:datos referencia medida) dn (at:dn-brida medida)
        campos (append campos (list (list "NUMERO_BARRENOS" (itoa (nth 11 datos)))
          (list "DN_REFERENCIA" (itoa dn)) (list "NPS_REFERENCIA" (pd:numero medida)))))
      (if (= (pd:valor pedido "unidad_brida") "DN")
        (progn
          (setq texto (strcat "BRIDA " (pd:valor campos "TIPO_BRIDA") " DN" (itoa dn)
            " " (itoa (nth 11 datos)) " BARRENOS CLASE " (at:clase-referencia referencia) " RF")
            campos (subst (list "MEDIDA_MAYOR" (strcat "DN" (itoa dn))) (assoc "MEDIDA_MAYOR" campos) campos)
            campos (subst '("UNIDAD_MEDIDA" "DN") (assoc "UNIDAD_MEDIDA" campos) campos)
            campos (pd:con-descripcion campos texto))))))
  campos)
(defun at:union-p (tipo) (member tipo '("BRIDA" "COCHI")))
(defun at:patron-conexion (referencia medida / fila)
  ;; Devuelve norma/patron, clase o PN, barrenos por extremo, circulo y diametro.
  ;; Solo referencias con conexiones bridadas; no deduce la clase por el servicio.
  (cond
    ((= referencia "CHECK_PN16")
      (setq fila (assoc medida '((2.0 125.0 18.0 4) (2.5 145.0 18.0 4)
        (3.0 160.0 18.0 8) (4.0 180.0 18.0 8) (5.0 210.0 22.0 8)
        (6.0 240.0 22.0 8) (8.0 295.0 22.0 12))))
      (if fila (list "EN1092 PN16" "PN16" (nth 3 fila) (cadr fila) (caddr fila))))
    ((member referencia '("CIEGA150" "SIN150" "CON150" "CIEGA300" "SIN300" "CON300" "VAPOR150" "BOLA150" "BOLA300" "MUNON150" "Y150" "Y300" "CHECK300" "GLOBO150"))
      (setq fila (assoc medida (at:tabla-brida-ref referencia)))
      (if fila (list (if (= referencia "Y150") "ASME B16.42" "ASME B16.5")
        (strcat "CLASE " (at:clase-referencia referencia) " RF") (nth 11 fila) (nth 9 fila) (nth 10 fila))))))
