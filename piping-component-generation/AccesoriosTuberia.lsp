(defun at:clase-referencia (referencia)
  (cond ((member referencia '("CIEGA300" "SIN300" "CON300" "Y300" "BOLA300" "CHECK300")) "300")
    ((= referencia "CHECK_PN16") "PN16")
    ((member referencia '("CIEGA150" "SIN150" "CON150" "VAPOR150" "BOLA150" "MUNON150" "Y150" "GLOBO150")) "150")
