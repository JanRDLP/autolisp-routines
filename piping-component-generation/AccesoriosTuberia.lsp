;;; ACCESORIOS: referencias dimensionales publicadas, modelos simplificados en mm.
;;; Requiere PiezaDatos y PiezasTuboNegro actualizados. Sin roscas ni texturas.

(defun at:catalogo (tipo)
  (cond
    ((= tipo "PVC") (pv:catalogo))
    ((= tipo "VBOLA")
      '(("BOLA_ROSCADA" "Roscada, sin WOG especificado (geometria generica compacta)")
        ("BOLA_ROSCADA_MM" "Macho-macho, sin WOG especificado (extremos lisos)")
        ("BOLA600" "Roscada, laton, 600 WOG (Walworth 7711)")
        ("BOLA1000" "Roscada, acero, 1000 WOG (Walworth 7011)")
        ("BOLA1000_316" "Roscada, inoxidable 316, 1000 WOG (Walworth 7011)")
        ("BOLA150" "Bridada flotante, clase 150 (Walworth 7112)")
        ("BOLA300" "Bridada flotante, clase 300 (Walworth 7312)")
        ("MUNON150" "Bridada montada, clase 150 (Walworth 8112)")))
    ((= tipo "VCHECK") '(("CHECK90" "Horizontal, laton, PN16, hasta 90 C (Italvalv)")
                         ("CHECK_Y" "Tipo Y, roscada, bronce, clase 150 (Walworth W420)")
                         ("LCV1" "Elevacion, bronce (Spirax LCV1)")
                         ("RESORTE" "Resorte roscada NPT, inox (Genebre 2416N)")
                         ("CHECK_PN16" "Bridada de columpio PN16 (Genebre 2455)")
                         ("CHECK300" "Bridada de columpio clase 300, 3 pulg (Bonney Forge)")))
