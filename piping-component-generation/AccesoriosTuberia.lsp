(defun at:capa (tipo)
  (cond ((= tipo "PVC") "ACCESORIOS PVC")
    ((= tipo "VBOLA") "VALVULA DE BOLA") ((= tipo "VCHECK") "VALVULA CHECK")
    ((= tipo "VGLOBO") "VALVULA DE GLOBO") ((= tipo "FY") "FILTRO Y")
    ((= tipo "COCHI") "COLA DE COCHI") (T tipo)))

