;;; PIEZA_DATOS v1. Datos estructurados, independientes de la descripcion visible.
;;; Biblioteca compartida: cargar antes de GCIF, PTN y ExportarInventario.
(setq pd:version "1")

;;; Destino dinamico de CREARPIEZA: nunca cambia CLAYER ni las capas internas.
(defun pd:capa-insercion (doc / nombre fila)
  (if (and (boundp 'pd:capa-destino) pd:capa-destino (/= pd:capa-destino ""))
    (progn
      (setq nombre pd:capa-destino fila (tblsearch "LAYER" nombre))
      (if (or (not (snvalid nombre 0)) (and fila (/= 0 (logand 21 (cdr (assoc 70 fila))))))
        (vl-exit-with-error "Capa de destino no valida, bloqueada, congelada o externa."))
      (if fila (cdr (assoc 2 fila))
        (progn (vla-Add (vla-get-Layers doc) nombre) nombre)))
    (getvar "CLAYER")))
(setq pd:capas-version "1")

(defun pd:numero (valor / texto)
  (setq texto (rtos valor 2 8))
  (if (vl-string-search "." texto)
    (setq texto (vl-string-right-trim "." (vl-string-right-trim "0" texto))))
  texto
)
(defun pd:valor (campos clave / par)
  (setq par (assoc clave campos))
  (if par (cadr par) "")
)
(defun pd:tipo (pieza)
  (cond ((member pieza '("C90" "C45")) "CODO")
    ((member pieza '("BUSHING" "CAMPANA" "CENTRICA" "EXCENTRICA")) "REDUCCION")
    ((= pieza "CACHUCHA") "TAPON CACHUCHA") ((= pieza "MACHO") "TAPON MACHO")
    ((= pieza "UNION") "TUERCA UNION") (T pieza))
)

(defun pd:ejes-tramo (ent / app par puntos)
  (setq app (assoc "TRAMO_EJES" (cdr (assoc -3 (entget ent '("TRAMO_EJES"))))))
  (foreach par (cdr app)
    (if (= (car par) 1011) (setq puntos (append puntos (list (cdr par))))))
  (if (= (length puntos) 2) puntos))

(defun pd:tramo-porcapa (solido / ent datos par salida verificado)
  (setq ent (vlax-vla-object->ename solido) datos (entget ent '("*")))
  ;; Retirar tambien TrueColor/nombre de color, que prevalecen sobre el ACI.
  (foreach par datos
    (if (not (member (car par) '(62 420 430)))
      (progn
        (setq salida (append salida (list par)))
        (if (and (= (car par) 100) (= (cdr par) "AcDbEntity"))
          (setq salida (append salida (list (cons 62 256))))))))
  ;; Color es una propiedad de AcDbEntity; XDATA debe permanecer al final.
  ;; Si falta el marcador de subclase, usar la API nativa en vez de DXF incompleto.
  (if (if (member (cons 100 "AcDbEntity") datos) (entmod salida)
      (progn (vla-put-Color solido 256) T))
    (progn
      (entupd ent) (setq verificado (entget ent '("*")))
      (and (or (null (assoc 62 verificado)) (= (cdr (assoc 62 verificado)) 256))
        (null (assoc 420 verificado)) (null (assoc 430 verificado))))))

(defun pd:guardar-ejes-tramo (solido inicio fin / ent datos grupo apps app nuevo)
  ;; 1011 conserva puntos WCS al mover, girar, copiar o reflejar la entidad.
  (setq ent (vlax-vla-object->ename solido) datos (entget ent '("*")) grupo (assoc -3 datos))
  (regapp "TRAMO_EJES")
  (foreach app (cdr grupo)
    (if (/= (car app) "TRAMO_EJES") (setq apps (append apps (list app)))))
  (setq apps (append apps (list (list "TRAMO_EJES" (cons 1070 1) (cons 1011 inicio) (cons 1011 fin))))
    nuevo (if grupo (subst (cons -3 apps) grupo datos) (append datos (list (cons -3 apps)))))
  (and (entmod nuevo) (progn (entupd ent) (equal (pd:ejes-tramo ent) (list inicio fin) 1e-7))))

(defun pd:campos-gcif (pieza mayor menor datos)
  (list
    (list "TIPO" (pd:tipo pieza))
    (list "ANGULO" (cond ((= pieza "C90") "90") ((= pieza "C45") "45") (T "")))
    (list "RADIO" "")
    (list "SUBTIPO" (cond ((member pieza '("BUSHING" "CAMPANA")) pieza)
      ((= pieza "COPLE") "REFORZADO") (T "")))
    (list "MATERIAL" "HIERRO MALEABLE") (list "ACABADO" "GALVANIZADO")
    (list "CONEXION" "ROSCADA")
    (list "ROSCA" "") (list "ROSCA_REFERENCIA" "NPT")
    (list "MEDIDA_MAYOR" (pd:numero mayor))
    (list "MEDIDA_MENOR" (if menor (pd:numero menor) ""))
    (list "UNIDAD_MEDIDA" "PULG")
    ;; C-40 conserva el nombre comercial del pedido; no es cedula tecnica inferida.
    (list "CEDULA" "") (list "CLASE" "")
    (list "REFERENCIA_COMERCIAL" (if (= pieza "UNION") "" "C-40"))
    (list "CLASE_REFERENCIA" "150")
    (list "MARCA" "") (list "MODELO" "")
    (list "CATALOGO_REFERENCIA" "CIFUNSA / HIERRO MALEABLE 150 LB")
    (list "ESTADO_DATOS" "REFERENCIA DE MODELO; COMPRA POR CONFIRMAR")
    (list "DE_REFERENCIA_MM" (pd:numero (car datos)))
    (list "DI_REFERENCIA_MM" (pd:numero (cadr datos)))
    (list "ORIGEN" "GCIF"))
)
(defun pd:campos-ptn (pieza cedula medida radio longitud datos)
  (list
    (list "TIPO" (pd:tipo pieza))
    (list "ANGULO" (cond ((= pieza "C90") "90") ((= pieza "C45") "45") (T "")))
    (list "RADIO" (if (= pieza "C90") radio ""))
    (list "SUBTIPO" "") (list "MATERIAL" "ACERO AL CARBON") (list "ACABADO" "NEGRO")
    (list "CONEXION" (if (= pieza "TRAMO") "" "SOLDABLE A TOPE"))
    (list "ROSCA" "") (list "ROSCA_REFERENCIA" "")
    (list "MEDIDA_MAYOR" (pd:numero medida)) (list "MEDIDA_MENOR" "")
    (list "UNIDAD_MEDIDA" "PULG") (list "CEDULA" cedula) (list "CLASE" "")
    (list "COSTURA" "")
    (list "LONGITUD_MM" (if (= pieza "TRAMO") (pd:numero longitud) ""))
    (list "REFERENCIA_COMERCIAL" "") (list "CLASE_REFERENCIA" "")
    (list "MARCA" "") (list "MODELO" "")
    (list "CATALOGO_REFERENCIA" "ASME B16.9-2001 / TABLAS DN")
    (list "ESTADO_DATOS" "DATOS ELEGIDOS AL CREAR; COMPRA POR CONFIRMAR")
    (list "DE_REFERENCIA_MM" (pd:numero (car datos)))
    (list "DI_REFERENCIA_MM" (pd:numero (cadr datos))) (list "ORIGEN" "PTN"))
)

(defun pd:codificar (texto campos / salida campo)
  (setq salida (list "PIEZA_DATOS" (cons 1000 "VERSION=1") (cons 1000 (strcat "ETIQUETA_BASE=" texto))))
  (foreach campo campos
    (setq salida (append salida (list (cons 1000 (strcat (car campo) "=" (cadr campo)))))))
  salida
)
(defun pd:guardar (solido texto marcador campos / ent datos grupo app nuevo estructura actualizado resultado guardado)
  (if (and solido texto (/= texto ""))
    (progn
      (setq ent (vlax-vla-object->ename solido) datos (entget ent '("*")) grupo (assoc -3 datos))
      (if (and (= (cdr (assoc 0 datos)) "3DSOLID")
               (null (assoc "ETIQUETA_PIEZA" (cdr grupo)))
               (null (assoc "PIEZA_DATOS" (cdr grupo))))
        (progn
          (regapp "ETIQUETA_PIEZA") (regapp "PIEZA_DATOS")
          (setq nuevo (list "ETIQUETA_PIEZA" (cons 1000 texto) (cons 1000 marcador))
                estructura (pd:codificar texto campos))
          (setq actualizado (if grupo
            (subst (cons -3 (append (cdr grupo) (list nuevo estructura))) grupo datos)
            (append datos (list (list -3 nuevo estructura)))))
          (setq resultado (entmod actualizado))
          (if resultado (entupd ent))
          (setq guardado (cdr (assoc -3 (entget ent '("ETIQUETA_PIEZA" "PIEZA_DATOS")))))
          (and resultado (equal nuevo (assoc "ETIQUETA_PIEZA" guardado))
                         (equal estructura (assoc "PIEZA_DATOS" guardado)))))))
)

(defun pd:leer (ent / grupo app etiqueta campos par texto posicion clave valor)
  (setq grupo (cdr (assoc -3 (entget ent '("ETIQUETA_PIEZA" "PIEZA_DATOS")))))
  (setq app (assoc "PIEZA_DATOS" grupo)
        etiqueta (cdr (assoc 1000 (cdr (assoc "ETIQUETA_PIEZA" grupo)))))
  (foreach par (cdr app)
    (if (= (car par) 1000)
      (progn
        (setq texto (cdr par) posicion (vl-string-search "=" texto))
        (if posicion
          (progn
            (setq clave (substr texto 1 posicion) valor (substr texto (+ posicion 2)))
            (setq campos (cons (list clave valor) campos)))))))
  ;; Una etiqueta editada puede describir otra pieza: no usar metadatos obsoletos.
  (if (and etiqueta (= (pd:valor campos "VERSION") "1")
           (/= (pd:valor campos "TIPO") "") (/= (pd:valor campos "MEDIDA_MAYOR") "")
           (= (pd:valor campos "ETIQUETA_BASE") etiqueta)) campos)
)
(defun pd:pulgadas (texto / par)
  (setq par (assoc texto '(("0.125" "1/8") ("0.25" "1/4") ("0.375" "3/8")
    ("0.5" "1/2") ("0.75" "3/4") ("1.25" "1 1/4") ("1.5" "1 1/2")
    ("2.5" "2 1/2") ("3.5" "3 1/2"))))
  (if par (cadr par) texto)
)
(defun pd:prefijo (prefijo valor)
  (if (= valor "") "" (strcat prefijo valor))
)
(defun pd:unir (partes / texto parte)
  (setq texto "")
  (foreach parte partes
    (if (and parte (/= parte ""))
      (setq texto (strcat texto (if (= texto "") "" " ") parte))))
  texto
)
;; Palabras clave validas de AutoCAD: fracciones con guiones (1-2 = 1/2).
;; El getreal tambien acepta el valor decimal escrito directamente.
(defun pd:opcion-medida (valor / texto)
  (setq texto (pd:pulgadas (pd:numero valor)))
  (while (vl-string-search "/" texto) (setq texto (vl-string-subst "-" "/" texto)))
  (while (vl-string-search " " texto) (setq texto (vl-string-subst "-" " " texto)))
  texto
)
(defun pd:pedir-medida (mensaje opciones / claves vista tabla opcion valor entrada resultado)
  (setq claves "" vista "")
  (foreach valor opciones
    (setq opcion (pd:opcion-medida valor)
          tabla (append tabla (list (list opcion valor)))
          claves (strcat claves (if (= claves "") "" " ") opcion)
          vista (strcat vista (if (= vista "") "" "/") opcion)))
  (if opciones
    (progn
      (princ "\nFracciones: 1-2 = 1/2; 1-1-2 = 1 1/2. Tambien puede escribir 0.5, 1.5, etc.")
      (while (null resultado)
        (initget 7 claves)
        (setq entrada (getreal (strcat "\n" mensaje " [" vista "] (pulgadas): ")))
        (setq valor (if (= (type entrada) 'STR) (cadr (assoc entrada tabla)) entrada))
        (if (member valor opciones)
          (setq resultado valor)
          (princ "\nMedida no disponible; seleccione una opcion o escriba su valor decimal.")))
      resultado)
    (princ "\nNo hay medidas disponibles para esta combinacion."))
)

(defun pd:comercial (campos / tipo partes medida)
  (if (/= (pd:valor campos "DESCRIPCION_COMPLETA") "")
    (pd:valor campos "DESCRIPCION_COMPLETA")
  (if (= (pd:valor campos "ORIGEN") "ACCESORIOS")
    (pd:valor campos "ETIQUETA_BASE")
    (progn
  (setq tipo (pd:valor campos "TIPO")
        partes (list tipo (pd:valor campos "ANGULO") (pd:valor campos "SUBTIPO")
          (pd:prefijo "RADIO " (pd:valor campos "RADIO")))
        medida (pd:pulgadas (pd:valor campos "MEDIDA_MAYOR")))
  (if (/= (pd:valor campos "MEDIDA_MENOR") "")
    (setq medida (strcat medida " x " (pd:pulgadas (pd:valor campos "MEDIDA_MENOR")))))
  (if (/= tipo "TUERCA UNION")
    (setq partes (append partes
      (list (if (= (pd:valor campos "ACABADO") "GALVANIZADO") "GALVANIZADO" "TUBO NEGRO SOLDABLE")
        (pd:valor campos "COSTURA") (pd:prefijo "C-" (pd:valor campos "CEDULA"))
        (pd:valor campos "REFERENCIA_COMERCIAL") (pd:prefijo "CLASE " (pd:valor campos "CLASE"))
        (pd:prefijo "ROSCA " (pd:valor campos "ROSCA"))))))
  (pd:unir (append partes (list "DE" (strcat medida "\"")
    (pd:prefijo "LARGO " (if (= (pd:valor campos "LONGITUD_MM") "") ""
      (strcat (pd:valor campos "LONGITUD_MM") " mm")))))))))
)
(defun pd:descripcion (ent etiqueta / campos)
  (setq campos (pd:leer ent))
  (if campos (pd:comercial campos) etiqueta)
)

(defun c:DATOSPIEZA (/ sel candidato candidatos ent etiqueta campos campo)
  (setq sel (nentselp "\nSeleccione una pieza, incluso dentro de un bloque: "))
  (if sel
    (progn
      (setq candidatos (append (reverse (nth 3 sel)) (list (car sel))))
      (foreach candidato candidatos
        (if (null ent)
          (progn
            (setq etiqueta (cdr (assoc 1000 (cdr (assoc "ETIQUETA_PIEZA"
              (cdr (assoc -3 (entget candidato '("ETIQUETA_PIEZA")))))))))
            (if etiqueta (setq ent candidato)))))
      (if ent
        (progn
          (princ (strcat "\nEtiqueta: " etiqueta "\nCapa propia: " (cdr (assoc 8 (entget ent)))))
          (setq campos (pd:leer ent))
          (if campos
            (progn
              (princ (strcat "\nDescripcion comercial: " (pd:comercial campos)))
              (foreach campo (reverse campos)
                (if (and (/= (cadr campo) "") (not (member (car campo) '("ETIQUETA_BASE" "VERSION"))))
                  (princ (strcat "\n" (car campo) ": " (cadr campo)))))
              (princ "\nLos campos vacios no se han confirmado. Referencia de catalogo no significa marca comprada."))
            (princ "\nSin datos estructurados vigentes. La etiqueta anterior se conserva; no se deducen especificaciones.")))
        (princ "\nNo se encontro una etiqueta en la pieza o sus contenedores."))))
  (princ)
)

;; Devuelve (hay-etiqueta recorrido-incompleto), sin modificar el dibujo.
(defun pd:buscar-etiquetas (ent pila / datos app nombre bloque hijo resultado encontrado aviso flags)
  (setq datos (entget ent)
        app (assoc "ETIQUETA_PIEZA" (cdr (assoc -3 (entget ent '("ETIQUETA_PIEZA"))))))
  (cond
    (app (list T nil))
    ((null datos) (list nil T))
    ((/= (cdr (assoc 0 datos)) "INSERT") (list nil nil))
    (T
      (setq nombre (cdr (assoc 2 datos)) bloque (tblobjname "BLOCK" nombre))
      (if (or (null bloque) (member nombre pila) (>= (length pila) 64))
        (list nil T)
        (progn
          (setq flags (cdr (assoc 70 (entget bloque))))
          (if (and flags (/= 0 (logand flags 12)))
            (list nil T)
            (progn
              (setq hijo (entnext bloque) encontrado nil aviso nil)
              (while (and hijo (not encontrado) (/= (cdr (assoc 0 (entget hijo))) "ENDBLK"))
                (setq resultado (pd:buscar-etiquetas hijo (cons nombre pila))
                      encontrado (car resultado) aviso (or aviso (cadr resultado))
                      hijo (entnext hijo)))
              (list encontrado aviso))))))))

;; Nombre legible a partir de la etiqueta; no altera la etiqueta almacenada.
(defun pd:nombre-bloque (texto / salida caracter codigo)
  (setq salida "")
  (foreach codigo (vl-string->list (strcase texto T))
    (setq caracter (chr codigo))
    (if (member caracter '("<" ">" "/" "\\" "\"" ":" ";" "?" "*" "|" "," "=" "`"))
      (setq caracter "-"))
    (setq salida (strcat salida caracter)))
  (setq salida (vl-string-trim " " salida))
  (if (= salida "") (setq salida "Pieza"))
  (setq salida (substr salida 1 220))
  (strcat (strcase (substr salida 1 1)) (substr salida 2)))

(defun pd:producto (a b)
  (+ (* (car a) (car b)) (* (cadr a) (cadr b)) (* (caddr a) (caddr b))))

;; Definiciones en ejes locales; cada insercion recibe posicion y UCS propios.
;; Asi se reutiliza la misma definicion incluso al cambiar el UCS.
(defun pd:marcos-bloque (punto / x y z)
  (setq x (trans '(1.0 0.0 0.0) 1 0 T)
        y (trans '(0.0 1.0 0.0) 1 0 T)
        z (trans '(0.0 0.0 1.0) 1 0 T))
  (pd:marcos-ejes punto x y z))

(defun pd:marcos-ejes (punto x y z)
  (list
    (vlax-tmatrix
      (list (append x (list (- (pd:producto x punto))))
            (append y (list (- (pd:producto y punto))))
            (append z (list (- (pd:producto z punto)))) '(0.0 0.0 0.0 1.0)))
    (vlax-tmatrix
      (list (list (car x) (car y) (car z) (car punto))
            (list (cadr x) (cadr y) (cadr z) (cadr punto))
            (list (caddr x) (caddr y) (caddr z) (caddr punto)) '(0.0 0.0 0.0 1.0)))))

;; Acad3DSolid no expone Area. Usar volumen y limites locales soportados.
(defun pd:geometria-compatible (a b / minimoA maximoA minimoB maximoB volumen)
  (setq volumen (vla-get-Volume a))
  (vla-GetBoundingBox a 'minimoA 'maximoA)
  (vla-GetBoundingBox b 'minimoB 'maximoB)
  (and (equal volumen (vla-get-Volume b) (* 1e-8 (max 1.0 volumen)))
       (equal (vlax-safearray->list minimoA) (vlax-safearray->list minimoB) 1e-6)
       (equal (vlax-safearray->list maximoA) (vlax-safearray->list maximoB) 1e-6)))

;; AddRegion puede invertir la normal. La extrusion debe seguir el eje pedido.
(defun pd:altura-extrusion (region eje longitud / normal)
  (setq normal (vlax-safearray->list (vlax-variant-value (vla-get-Normal region))))
  (if (< (pd:producto normal eje) 0.0) (- longitud) longitud))

(defun pd:con-descripcion (campos texto / anterior par)
  (setq anterior (assoc "DESCRIPCION_COMPLETA" campos) par (list "DESCRIPCION_COMPLETA" texto))
  (if anterior (subst par anterior campos) (append campos (list par))))

(defun pd:tramo-costura (campos capa / nombre par)
  ;; Regla del proyecto; no deduce material para otros tipos de tuberia.
  (if (and (= (pd:valor campos "TIPO") "TRAMO")
      (or (= (pd:valor campos "ORIGEN") "PTN")
          (vl-string-search "NEGRO" (strcase (pd:valor campos "MATERIAL")))))
    (progn
      (setq nombre (strcat "TUBO NEGRO SOLDABLE "
        (if (vl-string-search "VAPOR" (strcase capa)) "SIN COSTURA" "CON COSTURA"))
        par (list "MATERIAL" nombre))
      (setq campos (if (assoc "MATERIAL" campos) (subst par (assoc "MATERIAL" campos) campos) (append campos (list par))))
      (pd:con-descripcion campos (strcat "TRAMO " nombre " C-" (pd:valor campos "CEDULA") " "
        (pd:valor campos "MEDIDA_MAYOR") "pulg L=" (pd:valor campos "LONGITUD_MM") "mm")))
    campos))

(defun pd:actualizar-tramo (objeto campos / ent antes grupo apps app texto etiqueta estructura nuevo verificado codificados par)
  (setq ent (vlax-vla-object->ename objeto) antes (entget ent '("*")) grupo (assoc -3 antes)
    texto (pd:etiqueta-breve campos)
    etiqueta (list "ETIQUETA_PIEZA" (cons 1000 texto) (cons 1000 "ACTUALIZARPIEZAS")))
  (foreach par campos
    (if (not (member (car par) '("VERSION" "ETIQUETA_BASE")))
      (setq codificados (append codificados (list par)))))
  (setq estructura (pd:codificar texto codificados))
  (foreach app (cdr grupo)
    (if (not (member (car app) '("ETIQUETA_PIEZA" "PIEZA_DATOS")))
      (setq apps (append apps (list app)))))
  (setq nuevo (subst (cons -3 (append apps (list etiqueta estructura))) grupo antes))
  (if (entmod nuevo)
    (progn
      (entupd ent)
      (setq verificado (cdr (assoc -3 (entget ent '("ETIQUETA_PIEZA" "PIEZA_DATOS"))))))
    (setq verificado nil))
  (if (and (equal etiqueta (assoc "ETIQUETA_PIEZA" verificado))
           (equal estructura (assoc "PIEZA_DATOS" verificado))) T
    (progn (entmod antes) (entupd ent) nil)))

(defun pd:etiqueta-breve (campos / tipo descripcion medida)
  (setq tipo (pd:valor campos "TIPO") descripcion (pd:valor campos "DESCRIPCION_COMPLETA")
        medida (pd:valor campos "MEDIDA_MAYOR"))
  (if (and (= tipo "TRAMO") (/= (pd:valor campos "ORIGEN") "TRAMO_DN")
      (not (vl-string-search "COSTURA" descripcion)))
    (strcat "TRAMO TUBO NEGRO C-" (pd:valor campos "CEDULA") " " medida "pulg L=" (pd:valor campos "LONGITUD_MM") "mm")
    (progn
      (if (= descripcion "") (setq descripcion (pd:comercial campos)))
      (while (vl-string-search "CEDULA " descripcion) (setq descripcion (vl-string-subst "C-" "CEDULA " descripcion)))
      descripcion)))
(setq pd:etiquetas-version "2")

;; El solido ya esta colocado en WCS y etiquetado. Solo se borra el original
;; despues de verificar la copia dentro del bloque y crear su referencia.
;; El llamador mantiene abierto su grupo DESHACER.
(defun pd:envolver-bloque (doc espacio solido etiqueta pieza punto)
  (pd:envolver-en-marco doc espacio solido etiqueta pieza (pd:marcos-bloque punto)))

(defun pd:envolver-en-marco (doc espacio solido etiqueta pieza marcos
  / nombre capa capaActiva capas capaObjeto capaNueva bloque bloqueNuevo referencia matriz copias copia resultado origen campos
    existente temporal compatible viejos)
  (setq origen (vlax-3d-point '(0.0 0.0 0.0))
        capaActiva (pd:capa-insercion doc) capa (pd:tipo pieza)
        nombre (pd:nombre-bloque etiqueta)
        campos (pd:leer (vlax-vla-object->ename solido)))
  (setq resultado
    (vl-catch-all-apply
      '(lambda ()
        (if (and campos (snvalid nombre))
          (progn
            (setq capas (vla-get-Layers doc))
            (if (tblsearch "LAYER" capa)
              (setq capaObjeto (vla-Item capas capa))
              (setq capaObjeto (vla-Add capas capa) capaNueva T))
            (if (= (vla-get-Lock capaObjeto) :vlax-true)
              (princ (strcat "\nLa capa " capa " esta bloqueada. No se modifico su estado."))
              (progn
                (if (tblsearch "BLOCK" nombre)
                  (progn
                    (setq bloque (vla-Item (vla-get-Blocks doc) nombre))
                    (if (and (= (vla-get-Count bloque) 1)
                             (= (vla-get-Units bloque) 0)
                             (equal (vlax-safearray->list (vlax-variant-value (vla-get-Origin bloque)))
                                    '(0.0 0.0 0.0) 1e-8))
                      (progn
                        (setq existente (vla-Item bloque 0))
                        (if (and (= (vla-get-ObjectName existente) "AcDb3dSolid")
                                 (equal campos (pd:leer (vlax-vla-object->ename existente)))
                                 (= (strcase (vla-get-Layer existente)) (strcase capa))
                                 (or (= (vla-get-Color existente) 0)
                                     (and (= pieza "UNION") (= (vla-get-Color existente) 9))))
                          (progn
                            (setq temporal (vla-Copy solido))
                            (vla-TransformBy temporal (car marcos))
                            (setq compatible (pd:geometria-compatible temporal existente))
                            (if (and compatible (= pieza "UNION")) (vla-put-Color existente 9))
                            (vla-Delete temporal) (setq temporal nil)))))
                    (if (not compatible)
                      (progn
                        (setq viejos (pd:actualizable bloque campos capa))
                        (if viejos (setq compatible (pd:renovar-conjunto doc bloque (list solido) viejos marcos capa)))))
                    (if (not compatible)
                      (progn
                        (princ (strcat "\nEl nombre ya existe con datos, geometria u organizacion distintos: " nombre
                                     ". No se reutilizo ni se sobrescribio; no se agregaron sufijos."))
                        (pd:detalle-conflicto bloque (list solido) campos))))
                  (progn
                    (setq bloque (vla-Add (vla-get-Blocks doc) origen nombre) bloqueNuevo T
                          matriz (vlax-make-safearray vlax-vbObject '(0 . 0)))
                    (vla-put-Units bloque 0)
                    (vlax-safearray-put-element matriz 0 solido)
                    (setq copias (vlax-variant-value (vla-CopyObjects doc matriz bloque))
                          copia (vlax-safearray-get-element copias 0))
                    (vla-TransformBy copia (car marcos))
                    (vla-put-Layer copia capa)
                    (vla-put-Color copia (if (= pieza "UNION") 9 0))
                    (setq compatible (and (= (vla-get-Count bloque) 1)
                                          (equal campos (pd:leer (vlax-vla-object->ename copia)))))))
                (if compatible
                  (progn
                    (setq referencia (vla-InsertBlock espacio origen nombre 1.0 1.0 1.0 0.0))
                    (vla-TransformBy referencia (cadr marcos))
                    (vla-put-Layer referencia capaActiva)
                    (vla-put-Color referencia 256)
                    ;; Sin etiqueta en la referencia: el inventario baja al solido.
                    (if (null (assoc -3 (entget (vlax-vla-object->ename referencia)
                                              '("ETIQUETA_PIEZA" "PIEZA_DATOS"))))
                      (progn (vla-Delete solido) referencia)))))))))
      nil))
  (if (or (vl-catch-all-error-p resultado) (null resultado))
    (progn
      (if referencia (vl-catch-all-apply 'vla-Delete (list referencia)))
      (if temporal (vl-catch-all-apply 'vla-Delete (list temporal)))
      (if bloqueNuevo (vl-catch-all-apply 'vla-Delete (list bloque)))
      (if capaNueva (vl-catch-all-apply 'vla-Delete (list capaObjeto)))
      (if (vl-catch-all-error-p resultado)
        (princ (strcat "\nNo se pudo crear el bloque: " (vl-catch-all-error-message resultado))))
      nil)
    (progn
      (princ (strcat "\nBloque: " nombre " | Solido: capa " capa ", color PorBloque."
                     "\nInsercion: capa " capaActiva ". Etiqueta y datos conservados en el solido interior."))
      resultado)))

;; Accesorios con varias partes coloreadas: una sola etiqueta en el cuerpo.
(defun pd:color-firma (objeto / datos)
  (setq datos (entget (vlax-vla-object->ename objeto)))
  (if (assoc 420 datos) (assoc 420 datos)
    (if (assoc 62 datos) (assoc 62 datos) (cons 62 256))))

(defun pd:etiqueta-app (objeto)
  (assoc "ETIQUETA_PIEZA" (cdr (assoc -3 (entget (vlax-vla-object->ename objeto) '("ETIQUETA_PIEZA"))))))

(defun pd:etiqueta-compatible (fuente objeto datos / a b marcadores)
  (setq a (pd:etiqueta-app fuente) b (pd:etiqueta-app objeto))
  (or (equal a b)
    (and (= (pd:valor datos "ORIGEN") "ACCESORIOS")
      (= (length a) 3) (= (length b) 3)
      (equal (cadr a) (cadr b))
      (setq marcadores (list (cons 1000 "ACCESORIOS") (cons 1000 "ACTUALIZARPIEZAS")))
      (equal (cadr a) (cons 1000 (pd:valor datos "ETIQUETA_BASE")))
      (member (nth 2 a) marcadores) (member (nth 2 b) marcadores))))

(defun pd:visual-generado-p (objeto)
  (equal (assoc "PIEZA_VISUAL" (cdr (assoc -3 (entget (vlax-vla-object->ename objeto) '("PIEZA_VISUAL")))))
    (list "PIEZA_VISUAL" (cons 1000 "ACCESORIOS"))))
(defun pd:datos-iguales (a b / par correcto)
  ;; Los pares XDATA pueden leerse en distinto orden; no cambia la especificacion.
  (setq correcto T)
  (foreach par (append a b)
    (if (not (equal (assoc (car par) a) (assoc (car par) b))) (setq correcto nil))) correcto)
(defun pd:partes-corresponden (partes restantes capa / objeto correcto fuente encontrado datos)
  (setq correcto (= (length partes) (length restantes)))
      (foreach fuente partes
        (if correcto
          (progn
            (setq encontrado nil datos (pd:leer (vlax-vla-object->ename fuente)))
            (if (not (or datos (pd:visual-generado-p fuente))) (setq correcto nil))
            (foreach objeto restantes
              (if (and correcto (not encontrado) (= (vla-get-ObjectName objeto) "AcDb3dSolid")
                (> (vla-get-Volume objeto) 0.0) (= (strcase (vla-get-Layer objeto)) (strcase capa))
                (pd:datos-iguales datos (pd:leer (vlax-vla-object->ename objeto)))
                (pd:etiqueta-compatible fuente objeto datos)
                (or (member (pd:valor datos "ORIGEN") '("GCIF" "PTN"))
                  (equal (pd:color-firma fuente) (pd:color-firma objeto)))
                (or datos (pd:visual-generado-p objeto)))
                (setq encontrado objeto)))
            (if encontrado (setq restantes (vl-remove encontrado restantes)) (setq correcto nil)))))
  (and correcto (null restantes)))
(defun pd:conjunto-administrado (bloque partes campos capa / restantes i objeto correcto)
  ;; Reusar por especificacion/revision; no sobrescribe ni vuelve a comparar ACIS.
  (setq correcto (and (= (pd:valor campos "ORIGEN") "ACCESORIOS")
    (/= (pd:valor campos "REVISION_GEOMETRIA") "")
    (= (vla-get-Count bloque) (length partes)) (= (vla-get-Units bloque) 0)
    (equal (vlax-safearray->list (vlax-variant-value (vla-get-Origin bloque))) '(0.0 0.0 0.0) 1e-8)) i 0)
  (if correcto
    (progn
      (repeat (vla-get-Count bloque)
        (setq objeto (vla-Item bloque i) restantes (cons objeto restantes) i (1+ i)))
      (setq correcto (pd:partes-corresponden partes restantes capa)))) correcto)
(defun pd:detalle-conflicto (bloque partes campos / i objeto datos par texto cantidad)
  (princ (strcat "\nPartes del bloque: " (itoa (vla-get-Count bloque))
    "; partes esperadas: " (itoa (length partes)) "."))
  (setq i 0 texto "" cantidad 0)
  (while (and (< i (vla-get-Count bloque)) (not datos))
    (setq objeto (vla-Item bloque i) datos (pd:leer (vlax-vla-object->ename objeto)) i (1+ i)))
  (if datos
    (progn
      (foreach par campos
        (if (and (< cantidad 6) (not (equal (pd:valor datos (car par)) (cadr par))))
          (setq texto (strcat texto (if (= texto "") "" ", ") (car par)) cantidad (1+ cantidad))))
      (princ (if (= texto "") "\nEspecificacion coincidente; revisar capas, colores o partes sin marcador."
        (strcat "\nDatos distintos: " texto "."))))
    (princ "\nNo se encontro un cuerpo con PIEZA_DATOS verificable."))
  (setq i 0)
  (repeat (min 6 (vla-get-Count bloque))
    (setq objeto (vla-Item bloque i))
    (princ (strcat "\nParte " (itoa (1+ i)) ": capa=" (vla-get-Layer objeto)
      "; color=" (vl-prin1-to-string (pd:color-firma objeto))
      "; visual=" (if (pd:visual-generado-p objeto) "SI" "NO")
      "; etiqueta=" (vl-prin1-to-string (pd:etiqueta-app objeto))))
    (setq i (1+ i))))

(defun pd:misma-especificacion (a b / campo correcto wika bola)
  (setq correcto T wika (and (= (pd:valor a "ORIGEN") "ACCESORIOS")
    (= (pd:valor a "MODELO_REFERENCIA") "WIKA111") (= (pd:valor b "MODELO_REFERENCIA") "WIKA111")
    (= (pd:valor b "REVISION_GEOMETRIA") "20")))
  ;; Solo la referencia generica conocida puede cambiar de envolvente/fuente.
  ;; Las dimensiones comerciales, WOG, material, nombre y demas datos se comparan.
  (setq bola (and (= (pd:valor a "ORIGEN") "ACCESORIOS")
    (= (pd:valor a "MODELO_REFERENCIA") "BOLA_ROSCADA")
    (= (pd:valor b "MODELO_REFERENCIA") "BOLA_ROSCADA")
    (= (pd:valor a "REVISION_GEOMETRIA") "17")
    (= (pd:valor b "REVISION_GEOMETRIA") "21")
    (= (pd:valor a "CATALOGO_REFERENCIA") "WALWORTH 7711 / BOLA FLOTANTE P16")
    (= (pd:valor b "CATALOGO_REFERENCIA") "GENERICO COMPACTO; A/C WALWORTH 7711; H 1-2IN NIBCO TS58070BV R2011; NO REPLICA COMERCIAL")))
  (foreach campo (append a b)
    (if (and (/= (car campo) "REVISION_GEOMETRIA")
             (not (and wika (member (car campo) '("CATALOGO_REFERENCIA" "LARGO_REFERENCIA_MM"))))
             (not (and bola (member (car campo) '("CATALOGO_REFERENCIA" "ALTURA_EJE_MANERAL_MM" "NOTA_ALTURA"))))
             (not (equal (pd:valor a (car campo)) (pd:valor b (car campo))))) (setq correcto nil))) correcto)
(defun pd:actualizable (bloque campos capa / i objeto datos encontrados correcto etiqueta viejos)
  (setq i 0 correcto T encontrados 0)
  (repeat (vla-get-Count bloque)
    (setq objeto (vla-Item bloque i) datos (pd:leer (vlax-vla-object->ename objeto)))
    (if (or (/= (vla-get-ObjectName objeto) "AcDb3dSolid")
            (/= (strcase (vla-get-Layer objeto)) (strcase capa))) (setq correcto nil))
    (if datos
      (progn
        (setq encontrados (1+ encontrados))
        (if (not (and (or (= (pd:valor datos "ORIGEN") "ACCESORIOS")
          (and (= (pd:valor datos "TIPO") "REDUCCION") (member (pd:valor datos "ORIGEN") '("GCIF" "PTN")))
          (and (= (pd:valor datos "TIPO") "NIPLE") (= (pd:valor datos "ORIGEN") "GCIF")
            (= (pd:valor campos "REVISION_GEOMETRIA") "NIPLE-REBAJE-1"))
          (and (= (pd:valor datos "ORIGEN") "GCIF")
            (or (= (pd:valor campos "REVISION_GEOMETRIA") "GCIF-BOCAS-1")
              (and (= (pd:valor datos "TIPO") "CODO") (= (pd:valor campos "REVISION_GEOMETRIA") "GCIF-CODO-2"))
              (and (= (pd:valor datos "TIPO") "TAPON CACHUCHA") (= (pd:valor campos "REVISION_GEOMETRIA") "GCIF-CACHUCHA-2"))
              (and (= (pd:valor datos "TIPO") "TEE") (= (pd:valor campos "REVISION_GEOMETRIA") "GCIF-TEE-2"))
              (and (= (pd:valor datos "TIPO") "TUERCA UNION") (= (pd:valor campos "REVISION_GEOMETRIA") "GCIF-UNION-3")))))
          (pd:misma-especificacion datos campos)
          (/= (pd:valor datos "REVISION_GEOMETRIA") (pd:valor campos "REVISION_GEOMETRIA")))) (setq correcto nil)))
      (if (not (equal (assoc "PIEZA_VISUAL" (cdr (assoc -3 (entget (vlax-vla-object->ename objeto) '("PIEZA_VISUAL")))))
        (list "PIEZA_VISUAL" (cons 1000 "ACCESORIOS")))) (setq correcto nil)))
    (setq viejos (cons objeto viejos) i (1+ i)))
  (if (and correcto (= encontrados 1) (= (vla-get-Units bloque) 0)
    (equal (vlax-safearray->list (vlax-variant-value (vla-get-Origin bloque))) '(0.0 0.0 0.0) 1e-8)) viejos))
(defun pd:renovar-conjunto (doc bloque partes viejos marcos capa / matriz i copias copia resultado respaldos objeto comprometido)
  ;; Preparar y verificar antes de retirar geometria anterior. Respaldos para restaurar si falla el cambio.
  (setq resultado (vl-catch-all-apply '(lambda ()
    (setq matriz (vlax-make-safearray vlax-vbObject (cons 0 (1- (length partes)))) i 0)
    (foreach objeto partes (vlax-safearray-put-element matriz i objeto) (setq i (1+ i)))
    (setq copias (vlax-safearray->list (vlax-variant-value (vla-CopyObjects doc matriz bloque))) i 0)
    (if (/= (length copias) (length partes)) (exit))
    (foreach copia copias
      (vla-TransformBy copia (car marcos)) (vla-put-Layer copia capa)
      (if (member (pd:valor (pd:leer (vlax-vla-object->ename copia)) "ORIGEN") '("GCIF" "PTN"))
        (vla-put-Color copia (if (= (pd:valor (pd:leer (vlax-vla-object->ename copia)) "TIPO") "TUERCA UNION") 9 0)))
      (setq i (1+ i)))
    (if (not (pd:partes-corresponden partes copias capa)) (exit))
    (foreach objeto viejos (setq respaldos (cons (list objeto (vla-Copy objeto)) respaldos)))
    (foreach objeto viejos (vla-Delete objeto))
    (setq comprometido T)
    (foreach objeto respaldos (vla-Delete (cadr objeto)))
    T) nil))
  (if (and (not (vl-catch-all-error-p resultado)) resultado)
    (progn
      ;; Las referencias existentes pueden conservar graficos en cache tras editar la definicion.
      (setq resultado (vl-catch-all-apply 'vla-Regen (list doc 1)))
      (princ "\nDefinicion generada actualizada; sus inserciones comparten la geometria corregida.")
      (if (vl-catch-all-error-p resultado)
        (princ "\nLa definicion se renovo; ejecute REGENALL para refrescar su visualizacion."))
      T)
    (progn
      (if (not comprometido)
        (progn
          (foreach copia copias (vl-catch-all-apply 'vla-Delete (list copia)))
          (foreach objeto respaldos
            (if (not (vlax-erased-p (car objeto))) (vl-catch-all-apply 'vla-Delete (list (cadr objeto)))))))
      nil)))
(setq pd:conjuntos-version "7")

(defun pd:envolver-conjunto (doc espacio partes etiqueta capa punto
  / nombre origen marcos campos bloque nuevo capaObjeto capaNueva referencia temporal
    resultado matriz copias copia fuente indice compatible copiados viejos administrado)
  (setq nombre (pd:nombre-bloque etiqueta) origen (vlax-3d-point '(0.0 0.0 0.0))
        marcos (pd:marcos-bloque punto) campos (pd:leer (vlax-vla-object->ename (car partes))))
  (setq resultado (vl-catch-all-apply
    '(lambda ()
      (if (and campos partes (snvalid nombre))
        (progn
          (if (tblsearch "LAYER" capa)
            (setq capaObjeto (vla-Item (vla-get-Layers doc) capa))
            (setq capaObjeto (vla-Add (vla-get-Layers doc) capa) capaNueva T))
          (if (/= (vla-get-Lock capaObjeto) :vlax-true)
            (progn
              (if (tblsearch "BLOCK" nombre)
                (progn
                  (setq bloque (vla-Item (vla-get-Blocks doc) nombre)
                        compatible (and (= (vla-get-Count bloque) (length partes))
                                        (= (vla-get-Units bloque) 0)
                                        (equal (vlax-safearray->list (vlax-variant-value (vla-get-Origin bloque)))
                                               '(0.0 0.0 0.0) 1e-8)) indice 0)
                  (setq administrado (and compatible (pd:conjunto-administrado bloque partes campos capa)))
                  (foreach fuente partes
                    (if (and compatible (not administrado))
                      (progn
                        (setq copia (vla-Item bloque indice))
                        (if (and (= (vla-get-ObjectName copia) "AcDb3dSolid")
                                 (equal (pd:leer (vlax-vla-object->ename fuente)) (pd:leer (vlax-vla-object->ename copia)))
                                 (pd:etiqueta-compatible fuente copia campos)
                                 (= (strcase (vla-get-Layer copia)) (strcase capa))
                                 (equal (pd:color-firma fuente) (pd:color-firma copia)))
                          (progn
                            (setq temporal (vla-Copy fuente))
                            (vla-TransformBy temporal (car marcos))
                            (setq compatible (pd:geometria-compatible temporal copia))
                            (vla-Delete temporal) (setq temporal nil))
                          (setq compatible nil))))
                    (setq indice (1+ indice)))
                  (if (not compatible)
                    (progn
                      (setq viejos (pd:actualizable bloque campos capa))
                      (if viejos (setq compatible (pd:renovar-conjunto doc bloque partes viejos marcos capa))))))
                (progn
                  (setq bloque (vla-Add (vla-get-Blocks doc) origen nombre) nuevo T
                        matriz (vlax-make-safearray vlax-vbObject (cons 0 (1- (length partes)))) indice 0)
                  (vla-put-Units bloque 0)
                  (foreach fuente partes (vlax-safearray-put-element matriz indice fuente) (setq indice (1+ indice)))
                  (setq copias (vlax-safearray->list (vlax-variant-value (vla-CopyObjects doc matriz bloque)))
                        compatible (= (length partes) (length copias)))
                  (setq indice 0)
                  (foreach copia copias
                    (vla-TransformBy copia (car marcos)) (vla-put-Layer copia capa)
                    (if (/= (pd:valor campos "ORIGEN") "ACCESORIOS")
                      (if (not (equal (pd:etiqueta-app copia) (pd:etiqueta-app (nth indice partes))))
                        (setq compatible nil)))
                    (setq indice (1+ indice)))
                  (if compatible
                    (setq compatible (if (= (pd:valor campos "ORIGEN") "ACCESORIOS")
                      (pd:conjunto-administrado bloque partes campos capa)
                      (equal campos (pd:leer (vlax-vla-object->ename (car copias)))))))))
              (if compatible
                (progn
                  (setq referencia (vla-InsertBlock espacio origen nombre 1.0 1.0 1.0 0.0))
                  (vla-TransformBy referencia (cadr marcos))
                  (vla-put-Layer referencia (pd:capa-insercion doc)) (vla-put-Color referencia 256)
                  (foreach fuente partes (vla-Delete fuente)) referencia)
                (progn
                  (princ (strcat "\nBloque incompatible con el mismo nombre: " nombre))
                  (if bloque (vl-catch-all-apply 'pd:detalle-conflicto (list bloque partes campos)))))))))) nil))
  ;; PRINc devuelve texto: aceptar exclusivamente la referencia creada.
  (if (and referencia (not (vl-catch-all-error-p resultado)) (eq resultado referencia))
    referencia
    (progn
      (if referencia (vl-catch-all-apply 'vla-Delete (list referencia)))
      (if temporal (vl-catch-all-apply 'vla-Delete (list temporal)))
      (if nuevo (vl-catch-all-apply 'vla-Delete (list bloque)))
      (if capaNueva (vl-catch-all-apply 'vla-Delete (list capaObjeto)))
      (if (vl-catch-all-error-p resultado) (princ (strcat "\n" (vl-catch-all-error-message resultado)))) nil)))

(princ "\nCargado: PiezaDatos v1 / DATOSPIEZA (biblioteca compartida).")
(princ)

;; Actualizacion opcional de etiquetas y nombres antiguos que terminaban con codigo.
(defun pd:datos-etiqueta-nueva (datos texto / grupo etiquetas estructura nuevo)
  (setq grupo (assoc -3 datos) etiquetas (assoc "ETIQUETA_PIEZA" (cdr grupo))
        estructura (assoc "PIEZA_DATOS" (cdr grupo)))
  (if (and etiquetas estructura)
    (progn
      (setq nuevo (subst (cons 1000 texto) (assoc 1000 (cdr etiquetas)) etiquetas)
            grupo (subst nuevo etiquetas grupo)
            nuevo (mapcar '(lambda (p)
              (if (and (listp p) (= (car p) 1000) (equal (vl-string-search "ETIQUETA_BASE=" (cdr p)) 0))
                (cons 1000 (strcat "ETIQUETA_BASE=" texto)) p)) estructura)
            grupo (subst nuevo estructura grupo))
      (subst grupo (assoc -3 datos) datos))))
(defun pd:plan-nombre (bloque / nombre i objeto campos base etiqueta planes correcto app)
  (setq nombre (vla-get-Name bloque) i 0 correcto T)
  (if (and (= 0 (logand 12 (cdr (assoc 70 (tblsearch "BLOCK" nombre)))))
           (or (vl-string-search "[a-" (strcase nombre T)) (vl-string-search "[p-" (strcase nombre T))))
    (progn
      (repeat (vla-get-Count bloque)
        (setq objeto (vlax-vla-object->ename (vla-Item bloque i)) campos (pd:leer objeto))
        (if (/= (cdr (assoc 0 (entget objeto))) "3DSOLID") (setq correcto nil))
        (if campos
          (if (member (pd:valor campos "ORIGEN") '("GCIF" "PTN" "ACCESORIOS"))
            (progn
              (setq etiqueta (pd:etiqueta-breve campos))
              (if (and base (/= base etiqueta)) (setq correcto nil))
              (setq base etiqueta planes (cons (list objeto (entget objeto '("*")) etiqueta) planes)))
            (setq correcto nil))
          (progn
            (setq app (assoc "PIEZA_VISUAL" (cdr (assoc -3 (entget objeto '("PIEZA_VISUAL"))))))
            (if (null app) (setq correcto nil))))
        (setq i (1+ i)))
      (if (and correcto planes) (list (pd:nombre-bloque base) planes)))))
(defun pd:aplicar-plan-nombre (bloque plan / fila resultado)
  (setq resultado (vl-catch-all-apply '(lambda ()
    (foreach fila (cadr plan)
      (if (null (entmod (pd:datos-etiqueta-nueva (cadr fila) (caddr fila)))) (exit))
      (entupd (car fila)))
    (vla-put-Name bloque (car plan)) T) nil))
  (if (or (vl-catch-all-error-p resultado) (null resultado))
    (progn (foreach fila (cadr plan) (entmod (cadr fila))) nil) T))
(defun pd:nombres-anidados (nombre pila / cabecera datos ent resultado)
  (setq cabecera (tblobjname "BLOCK" nombre))
  (if (and cabecera (not (member nombre pila)) (< (length pila) 64)
           (= 0 (logand 12 (cdr (assoc 70 (entget cabecera))))))
    (progn
      (setq resultado (list nombre) ent (entnext cabecera))
      (while (and ent (/= (cdr (assoc 0 (entget ent))) "ENDBLK"))
        (setq datos (entget ent))
        (if (= (cdr (assoc 0 datos)) "INSERT")
          (setq resultado (append resultado (pd:nombres-anidados (cdr (assoc 2 datos)) (cons nombre pila)))))
        (setq ent (entnext ent))) resultado)))
(defun c:ACTUALIZARNOMBRESPIEZAS (/ *error* doc undo modo seleccion nombres i datos nombre bloque plan resultado fila correctos omitidos)
  (defun *error* (mensaje)
    (if undo (vla-EndUndoMark doc))
    (if mensaje (princ (strcat "\nActualizacion interrumpida: " mensaje))) (princ))
  (vl-load-com)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) correctos 0 omitidos 0)
  (initget "Seleccion Todo")
  (setq modo (getkword "\nQuitar codigos de piezas generadas [Seleccion/Todo] <Seleccion>: "))
  (if (= modo "Todo")
    (progn
      (setq datos (tblnext "BLOCK" T))
      (while datos
        (if (= 0 (logand 12 (cdr (assoc 70 datos)))) (setq nombres (cons (cdr (assoc 2 datos)) nombres)))
        (setq datos (tblnext "BLOCK"))))
    (progn
      (setq seleccion (ssget '((0 . "INSERT"))) i 0)
      (if seleccion (repeat (sslength seleccion)
        (foreach nombre (pd:nombres-anidados (cdr (assoc 2 (entget (ssname seleccion i)))) nil)
          (if (not (member nombre nombres)) (setq nombres (cons nombre nombres))))
        (setq i (1+ i))))))
  (vla-StartUndoMark doc) (setq undo T)
  (foreach nombre nombres
    (setq bloque (vla-Item (vla-get-Blocks doc) nombre) plan (pd:plan-nombre bloque))
    (if plan
      (if (tblsearch "BLOCK" (car plan))
        (progn (setq omitidos (1+ omitidos)) (princ (strcat "\nSe conserva " nombre ": ya existe " (car plan))))
        (progn
          (if (pd:aplicar-plan-nombre bloque plan)
            (setq correctos (1+ correctos)) (setq omitidos (1+ omitidos)))))))
  (vla-EndUndoMark doc) (setq undo nil)
  (princ (strcat "\nDefiniciones actualizadas: " (itoa correctos) "; omitidas por conflicto/fallo: " (itoa omitidos)
    ". Todas sus inserciones comparten el nombre nuevo. DESHACER revierte el lote.")) (princ))

